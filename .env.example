# ---- Supabase (public, safe in the browser) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Server-side only (Supabase Edge Function secrets) ----
# Never use the VITE_ prefix for these.
# Local function dev: supabase functions serve --env-file .env
# Production:        supabase secrets set GEMINI_API_KEY=... GIPHY_API_KEY=...
# Free Gemini key (no card): https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# optional — defaults to gemini-2.5-flash with automatic fallbacks
GEMINI_MODEL=
# Free GIPHY key: https://developers.giphy.com → Create an App → API
GIPHY_API_KEY=