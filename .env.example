# ---- Supabase (public, safe in the browser) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Server-side only (Supabase Edge Function secrets) ----
# Never use the VITE_ prefix for these.
# Local function dev: supabase functions serve --env-file .env
# Production:        supabase secrets set ANTHROPIC_API_KEY=... GIPHY_API_KEY=...
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GIPHY_API_KEY=